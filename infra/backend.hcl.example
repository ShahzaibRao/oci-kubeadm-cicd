# ============================================================
# Backend config — LOCAL runs ke liye.
# Copy to backend.hcl (gitignored, kabhi commit nahi).
# CI mein -backend-config flags workflow se aayenge.
# ============================================================

# WHAT: R2 bucket jisme terraform.tfstate rahega.
# Pehle Cloudflare dashboard → R2 → Create bucket: tfstate-kubeadm-cicd
bucket = "tfstate-kubeadm-cicd"
key    = "oci-kubeadm-cicd/terraform.tfstate"
region = "auto"

endpoints = {
  # <ACCOUNT_ID>: Cloudflare dashboard → R2 → Overview mein
  s3 = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
}

# WHY ye flags: R2 S3-compatible hai lekin AWS nahi — ye checks
# AWS-specific hain, R2 par fail hote hain is liye skip.
skip_credentials_validation = true
skip_metadata_api_check      = true
skip_region_validation       = true
skip_requesting_account_id   = true
use_lockfile                 = true

# R2 credentials env vars se aate hain (kabhi file mein nahi):
#   export AWS_ACCESS_KEY_ID="<r2-access-key-id>"
#   export AWS_SECRET_ACCESS_KEY="<r2-secret-access-key>"
# R2 API token: Cloudflare dashboard → R2 → Manage R2 API Tokens
